generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Documento {
  id           String   @id @default(uuid()) @db.Uuid
  nomeOriginal String
  key          String   @unique
  tamanho      Int
  criadoEm     DateTime @default(now())
}
